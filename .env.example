# Copy to `.env` (gitignored) before `docker compose up`.

# -- Database ---------------------------------------------------------------------------------
# The only variable with no default: the service refuses to start without it.
DATABASE_URL=postgresql+psycopg2://example:example@db:5432/example_api
# Target of the `test` compose service. Defaults to DATABASE_URL with `_test` appended to the
# database name if left unset - set explicitly only to point it somewhere else.
# TEST_DATABASE_URL=postgresql+psycopg2://example:example@db:5432/example_api_test

# Consumed by the `db` service to bootstrap its own user/password/database; must match
# DATABASE_URL above.
POSTGRES_USER=example
POSTGRES_PASSWORD=example
POSTGRES_DB=example_api

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
HEALTHCHECK_DB_TIMEOUT_SECONDS=2

# -- Application --------------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
PORT=8000

# -- Gunicorn -------------------------------------------------------------------------------------
# GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=60

# -- Auth (Cognito) ---------------------------------------------------------------------------
# Unset is tolerated in local/test (the mock_cognito_auth test fixture signs its own tokens).
# Required when APP_ENV is staging/production - enforced by Settings at startup.
# COGNITO_REGION=
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
